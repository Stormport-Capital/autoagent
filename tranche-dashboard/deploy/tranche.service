[Unit]
Description=Tranche dashboard (paper trading)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
User=tranche
Group=tranche
WorkingDirectory=/opt/tranche/autoagent/tranche-dashboard
ExecStart=/opt/tranche/autoagent/tranche-dashboard/deploy/run.sh
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
