# Copy this file to ".env" (same folder) and paste your keys after the = signs.
# .env is git-ignored: it never gets committed. No quotes, no spaces around =.

# Polygon (market data) - https://polygon.io/dashboard/keys
POLYGON_API_KEY=

# Alpaca PAPER trading keys - generated on the PAPER dashboard, not the live one
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
