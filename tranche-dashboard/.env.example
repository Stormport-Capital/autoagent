# Copy this file to ".env" (same folder) and paste your keys after the = signs.
# .env is git-ignored: it never gets committed. No quotes, no spaces around =.

# Polygon (market data) - https://polygon.io/dashboard/keys
POLYGON_API_KEY=

# OPTIONAL - FMP (market data) - https://site.financialmodelingprep.com/developer/docs/dashboard
# With both keys set, the startup window tests both and shows how delayed each is.
FMP_API_KEY=
# Which data source to trade from: polygon or fmp (default: polygon if its key is set)
TRANCHE_PROVIDER=

# Alpaca PAPER trading keys - generated on the PAPER dashboard, not the live one
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# OPTIONAL - a SECOND Alpaca paper account for the 15-min book. It must be a
# different paper account from the one above (Alpaca holds one net position per
# stock per account, so two books sharing one would cancel each other out).
APCA_15M_API_KEY_ID=
APCA_15M_API_SECRET_KEY=

# OPTIONAL - a THIRD Alpaca paper account for the 5-min book. Again a different
# paper account from both of the above.
APCA_5M_API_KEY_ID=
APCA_5M_API_SECRET_KEY=

# OPTIONAL - where to keep safe backup copies of the databases, e.g. a Google
# Drive folder (Google Drive for desktop is usually G:\My Drive). No quotes.
# Default: the "backups" folder next to the app.
TRANCHE_BACKUP_DIR=

# OPTIONAL - require this password to open the dashboard (always set on a server)
TRANCHE_PASSWORD=

# OPTIONAL - Interactive Brokers, for ONE book (paper or LIVE). Needs IB Gateway
# running on this machine; step by step in IBKR.md. Leave IBKR_ACCOUNT empty to
# keep IBKR off. The account ID decides the mode: DU... = paper, U... = live,
# and it must match IBKR_MODE or nothing connects.
IBKR_ACCOUNT=
IBKR_MODE=paper
# Which book trades at IBKR: 1h, 15m or 5m (that book stops using its Alpaca keys)
IBKR_BOOK=
# Safety limits (defaults shown): shares per symbol, daily loss in $, max $ per order
IBKR_MAX_SHARES=1
IBKR_DAILY_LOSS_LIMIT=100
IBKR_MAX_ORDER_USD=1000
# Advanced (defaults: 127.0.0.1, 4002 paper / 4001 live, client 17, limit, 3, 45, 1)
IBKR_HOST=
IBKR_PORT=
IBKR_CLIENT_ID=
IBKR_ORDER_TYPE=
IBKR_LIMIT_COLLAR_PCT=
IBKR_REPRICE_S=
# 1 = real-time quotes (needs a market data subscription), 3 = 15-min delayed
IBKR_MARKET_DATA_TYPE=
